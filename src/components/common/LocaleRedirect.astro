---
import { LOCALE_STORAGE_KEY } from '~/i18n';

export interface Props {
  arabicHref: string;
}

const { arabicHref } = Astro.props;
---

<script is:inline define:vars={{ storageKey: LOCALE_STORAGE_KEY, arabicHref }}>
  const readSaved = () => {
    try {
      return localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };
  const languages = navigator.languages?.length ? navigator.languages : [navigator.language || ''];
  const preferred =
    readSaved() ||
    languages
      .map((language) => String(language).slice(0, 2).toLowerCase())
      .find((code) => code === 'ar' || code === 'en');
  if (preferred === 'ar') location.replace(arabicHref);
</script>

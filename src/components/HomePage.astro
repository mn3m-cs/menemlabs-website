---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import vetdiwanLogo from '~/assets/images/vetdiwan-logo.png';

import { t, type Locale } from '~/i18n';
import { CONTACT_EMAIL, CONTACT_HREF } from '~/navigation';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const WORK_ICONS = [
  'tabler:calendar-event',
  'tabler:paw',
  'tabler:stethoscope',
  'tabler:pill',
  'tabler:receipt',
  'tabler:users',
];

const OPEN_GRAPH_LOCALES: Record<Locale, string> = { en: 'en_US', ar: 'ar_AR' };

const metadata = {
  title: dict.metadata.title,
  description: dict.metadata.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: OPEN_GRAPH_LOCALES[locale] },
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: locale,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    email: CONTACT_EMAIL,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata} locale={locale} translatedPath="/">
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    tagline={dict.hero.tagline}
    title={dict.hero.title}
    subtitle={dict.hero.subtitle}
    actions={[{ variant: 'primary', text: dict.hero.primaryAction, href: CONTACT_HREF, icon: 'tabler:mail' }]}
  />

  <Content
    id="work"
    tagline={dict.work.tagline}
    title={dict.work.title}
    subtitle={dict.work.subtitle}
    content={dict.work.description}
    callToAction={{
      text: dict.work.demo,
      href: `${CONTACT_HREF}?subject=VetDiwan`,
      icon: locale === 'ar' ? 'tabler:arrow-narrow-left' : 'tabler:arrow-narrow-right',
    }}
    items={dict.work.items.map((item, index) => ({ ...item, icon: WORK_ICONS[index] }))}
    columns={2}
  >
    <div
      slot="image"
      class="flex items-center justify-center rounded-2xl bg-white p-12 shadow-lg ring-1 ring-slate-200 dark:ring-slate-700"
    >
      <img src={vetdiwanLogo.src} width="160" height="160" alt={dict.work.logoAlt} loading="lazy" />
    </div>
  </Content>

  <CallToAction
    id="contact"
    title={dict.contact.title}
    subtitle={dict.contact.subtitle}
    actions={[{ variant: 'primary', text: CONTACT_EMAIL, href: CONTACT_HREF, icon: 'tabler:mail' }]}
  />
</Layout>

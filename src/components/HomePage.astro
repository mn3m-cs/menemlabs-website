---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import ContactSection from '~/components/widgets/ContactSection.astro';
import { Icon } from 'astro-icon/components';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import vetdiwanLogo from '~/assets/images/vetdiwan-logo.png';

import { t, type Locale } from '~/i18n';
import { CONTACT_EMAIL } from '~/navigation';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const EXPERTISE_ICONS = ['tabler:heartbeat', 'tabler:building-skyscraper', 'tabler:key', 'tabler:code'];

const PROJECT_ICONS: Record<string, string[]> = {
  vetdiwan: [
    'tabler:calendar-event',
    'tabler:paw',
    'tabler:stethoscope',
    'tabler:pill',
    'tabler:receipt',
    'tabler:users',
  ],
  cooperative: ['tabler:book-2', 'tabler:building', 'tabler:receipt-2', 'tabler:file-type-pdf', 'tabler:devices-pc'],
};

const forwardArrow = locale === 'ar' ? 'tabler:arrow-narrow-left' : 'tabler:arrow-narrow-right';

const OPEN_GRAPH_LOCALES: Record<Locale, string> = { en: 'en_US', ar: 'ar_AR' };

const metadata = {
  title: dict.metadata.title,
  description: dict.metadata.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: OPEN_GRAPH_LOCALES[locale] },
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: locale,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    email: CONTACT_EMAIL,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata} locale={locale} translatedPath="/">
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    tagline={dict.hero.tagline}
    title={dict.hero.title}
    subtitle={dict.hero.subtitle}
    actions={[{ variant: 'primary', text: dict.hero.primaryAction, href: '#contact', icon: 'tabler:mail' }]}
  />

  <Features
    id="team_exp"
    tagline={dict.expertise.tagline}
    title={dict.expertise.title}
    subtitle={dict.expertise.subtitle}
    items={dict.expertise.items.map((item, index) => ({ ...item, icon: EXPERTISE_ICONS[index] }))}
    columns={2}
  />

  {
    dict.work.projects.map((project, index) => (
      <Content
        id={index === 0 ? 'work' : `work-${project.id}`}
        tagline={index === 0 ? dict.work.tagline : undefined}
        title={project.title}
        subtitle={project.subtitle}
        content={project.description}
        callToAction={{ text: project.action, href: '#contact', icon: forwardArrow }}
        items={project.items.map((item, itemIndex) => ({ ...item, icon: PROJECT_ICONS[project.id]?.[itemIndex] }))}
        columns={2}
        isReversed={index % 2 === 1}
      >
        <div
          slot="image"
          class="flex items-center justify-center rounded-2xl bg-white p-12 shadow-lg ring-1 ring-slate-200 dark:ring-slate-700"
        >
          {project.id === 'vetdiwan' ? (
            <img src={vetdiwanLogo.src} width="160" height="160" alt={project.imageAlt} loading="lazy" />
          ) : (
            <Icon name="tabler:building-community" class="w-40 h-40 text-primary" aria-label={project.imageAlt} />
          )}
        </div>
      </Content>
    ))
  }

  <ContactSection
    id="contact"
    title={dict.contact.title}
    subtitle={dict.contact.subtitle}
    email={CONTACT_EMAIL}
    labels={dict.contact}
  />
</Layout>

---
// Font families are provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`
// and `--font-arabic`. Arabic pages switch every `--aw-font-*` to the Arabic face.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(13 148 136);
    --aw-color-secondary: rgb(15 118 110);
    --aw-color-accent: rgb(13 148 136);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 41 59);
    --aw-color-text-muted: rgb(30 41 59 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(15 23 42);

    ::selection {
      background-color: rgb(45 212 191 / 30%);
    }
  }

  .dark {
    --aw-color-primary: rgb(45 212 191);
    --aw-color-secondary: rgb(94 234 212);
    --aw-color-accent: rgb(45 212 191);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(226 232 240 / 66%);
    --aw-color-bg-page: rgb(15 23 42);

    ::selection {
      background-color: rgb(45 212 191 / 40%);
      color: rgb(248 250 252);
    }
  }

  :root[lang='ar'] {
    --aw-font-sans: var(--font-arabic);
    --aw-font-serif: var(--font-arabic);
    --aw-font-heading: var(--font-arabic);
  }
</style>

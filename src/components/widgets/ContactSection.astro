---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface FormLabels {
  name: string;
  email: string;
  phone: string;
  company: string;
  optional: string;
  need: string;
  needs: string[];
  message: string;
  messagePlaceholder: string;
  submit: string;
  sending: string;
  sent: string;
  sentDetail: string;
  failed: string;
  orEmail: string;
  subject: string;
}

export interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  email: string;
  accessKey?: string;
  labels: { copy: string; copied: string; openMailApp: string; openGmail: string };
  form: FormLabels;
}

const { id, title, subtitle, email, accessKey, labels, form } = Astro.props;

const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}`;
const fieldClass =
  'py-3 px-4 block w-full rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-default focus:border-primary focus:ring-primary';
---

<WidgetWrapper id={id} containerClass="max-w-6xl mx-auto">
  <div class="max-w-3xl mx-auto p-6 md:p-8 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600">
    <Headline
      title={title}
      subtitle={subtitle}
      classes={{
        container: 'mb-0 md:mb-0 text-center',
        title: 'text-4xl md:text-4xl font-bold tracking-tighter mb-4 font-heading',
        subtitle: 'text-xl text-muted dark:text-slate-400',
      }}
    />

    {
      accessKey && (
        <Fragment>
          <form class="mt-8 grid gap-4 sm:grid-cols-2" data-contact-form data-astro-reload>
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value={form.subject} />
            <input type="hidden" name="from_name" value="menemlabs.tech" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

            <label class="block">
              <span class="block text-sm font-medium mb-1">{form.name}</span>
              <input type="text" name="name" required autocomplete="name" class={fieldClass} />
            </label>
            <label class="block">
              <span class="block text-sm font-medium mb-1">{form.email}</span>
              <input type="email" name="email" required autocomplete="email" dir="ltr" class={fieldClass} />
            </label>
            <label class="block">
              <span class="block text-sm font-medium mb-1">
                {form.phone} <span class="text-muted font-normal">({form.optional})</span>
              </span>
              <input type="tel" name="phone" autocomplete="tel" dir="ltr" class={fieldClass} />
            </label>
            <label class="block">
              <span class="block text-sm font-medium mb-1">
                {form.company} <span class="text-muted font-normal">({form.optional})</span>
              </span>
              <input type="text" name="company" autocomplete="organization" class={fieldClass} />
            </label>
            <label class="block sm:col-span-2">
              <span class="block text-sm font-medium mb-1">{form.need}</span>
              <select name="need" class={fieldClass}>
                {form.needs.map((need) => (
                  <option value={need}>{need}</option>
                ))}
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="block text-sm font-medium mb-1">{form.message}</span>
              <textarea name="message" rows="5" required placeholder={form.messagePlaceholder} class={fieldClass} />
            </label>

            <div class="sm:col-span-2 flex flex-col items-center gap-3">
              <button type="submit" class="btn-primary gap-2 w-full sm:w-auto" data-sending-label={form.sending}>
                <Icon name="tabler:send" class="w-5 h-5" />
                <span data-submit-label>{form.submit}</span>
              </button>
              <p class="hidden text-sm text-red-600 dark:text-red-400" data-form-failed role="alert">
                {form.failed}
              </p>
            </div>
          </form>
          <div class="hidden mt-8 text-center" data-form-sent role="status">
            <Icon name="tabler:circle-check" class="w-12 h-12 mx-auto text-primary" />
            <p class="mt-3 text-xl font-semibold">{form.sent}</p>
            <p class="mt-1 text-muted">{form.sentDetail}</p>
          </div>
        </Fragment>
      )
    }

    <div class="mt-8 flex flex-col items-center gap-3">
      {accessKey && <p class="text-sm text-muted">{form.orEmail}</p>}
      <div
        class="inline-flex items-center gap-3 rounded-xl border border-gray-200 dark:border-slate-600 ps-4 pe-2 py-2"
        dir="ltr"
      >
        <Icon name="tabler:mail" class="w-5 h-5 text-primary" />
        <span class="text-lg md:text-xl font-semibold select-all">{email}</span>
        <button
          type="button"
          class="btn btn-tertiary gap-1.5 py-1.5 px-3 text-sm"
          data-copy-email={email}
          data-copied-label={labels.copied}
          dir="auto"
        >
          <Icon name="tabler:copy" class="w-4 h-4" />
          <span data-copy-label>{labels.copy}</span>
        </button>
      </div>

      {
        !accessKey && (
          <div class="flex flex-wrap justify-center gap-3">
            <Button
              variant="primary"
              text={labels.openGmail}
              href={gmailHref}
              target="_blank"
              icon="tabler:brand-gmail"
            />
            <Button variant="secondary" text={labels.openMailApp} href={`mailto:${email}`} icon="tabler:mail-forward" />
          </div>
        )
      }
    </div>
  </div>
</WidgetWrapper>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy-email]');
    if (!button) return;
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail || '');
    } catch {
      return;
    }
    if (!label) return;
    const original = label.textContent;
    label.textContent = button.dataset.copiedLabel || '';
    setTimeout(() => (label.textContent = original), 2000);
  });

  document.addEventListener('submit', async (event) => {
    const form = (event.target as Element | null)?.closest<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    event.preventDefault();

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const failed = form.querySelector<HTMLElement>('[data-form-failed]');
    const sent = form.parentElement?.querySelector<HTMLElement>('[data-form-sent]');
    const idleLabel = submitLabel?.textContent;

    failed?.classList.add('hidden');
    if (submit) submit.disabled = true;
    if (submitLabel) submitLabel.textContent = submit?.dataset.sendingLabel || '';

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message || String(response.status));
      form.classList.add('hidden');
      sent?.classList.remove('hidden');
    } catch {
      failed?.classList.remove('hidden');
      if (submit) submit.disabled = false;
      if (submitLabel) submitLabel.textContent = idleLabel || '';
    }
  });
</script>

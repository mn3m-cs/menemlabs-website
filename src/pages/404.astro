---
import Layout from '~/layouts/Layout.astro';
import { LOCALES, t, getDirection, getLocalePermalink } from '~/i18n';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        {
          LOCALES.map((locale) => (
            <div lang={locale} dir={getDirection(locale)} class="mb-8">
              <p class="text-2xl font-semibold mb-4">{t(locale).notFound.title}</p>
              <a href={getLocalePermalink(locale)} class="btn">
                {t(locale).notFound.back}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { SITE } from 'astrowind:config';

import { DEFAULT_LOCALE, LOCALES, LOCALE_STORAGE_KEY, getDirection, getLocalePermalink, type Locale } from '~/i18n';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';
import LocaleRedirect from '~/components/common/LocaleRedirect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  locale?: Locale;
  translatedPath?: string;
}

const { metadata = {}, locale = DEFAULT_LOCALE, translatedPath } = Astro.props;

const alternates = translatedPath
  ? LOCALES.map((alternate) => ({
      hreflang: alternate,
      href: new URL(getLocalePermalink(alternate, translatedPath), SITE?.site).toString(),
    }))
  : [];

const autoDetectLocale = locale === DEFAULT_LOCALE && translatedPath === '/';
const arabicHomeHref = getLocalePermalink('ar');
---

<!doctype html>
<html lang={locale} dir={getDirection(locale)} class="2xl:text-[20px]">
  <head>
    {autoDetectLocale && <LocaleRedirect arabicHref={arabicHomeHref} />}
    <script is:inline define:vars={{ storageKey: LOCALE_STORAGE_KEY }}>
      document.addEventListener('click', function (event) {
        const link = event.target?.closest?.('[data-set-locale]');
        if (!link) return;
        try {
          localStorage.setItem(storageKey, link.getAttribute('data-set-locale'));
        } catch {
          return;
        }
      });
    </script>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload={locale !== 'ar'} />
    <Font cssVariable="--font-arabic" preload={locale === 'ar'} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.hreflang === DEFAULT_LOCALE)?.href} />
      )
    }
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />
  </body>
</html>
